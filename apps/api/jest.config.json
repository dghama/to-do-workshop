{
  "rootDir": ".",
  "roots": ["<rootDir>/src"],
  "testEnvironment": "node",
  "extensionsToTreatAsEsm": [".ts"],
  "testMatch": ["**/*.test.ts"],
  "transform": {
    "^.+\\.[tj]sx?$": ["babel-jest", { "rootMode": "upward" }]
  },
  "moduleFileExtensions": ["ts", "js", "json"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
